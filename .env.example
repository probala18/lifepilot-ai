# ── OpenRouter LLM Configuration ──────────────────────────────────────────────
# Obtain an API key from https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."
# Free tier models:
#   google/gemini-2.0-flash-exp:free (Default, fast & smart)
#   meta-llama/llama-3.3-70b-instruct:free
#   deepseek/deepseek-r1:free
#   qwen/qwen-2.5-coder-32b-instruct:free
OPENROUTER_MODEL="google/gemini-2.0-flash-exp:free"

# ── Amazon Bedrock (Optional Fallback) ────────────────────────────────────────
# AWS credentials are resolved via the default SDK credential chain:
#   env vars → ~/.aws/credentials → IAM role
# Set these if you are NOT using an IAM role or shared credentials file.
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="us-east-1"

# Optional: override the default Nova model / inference profile ARN
# BEDROCK_MODEL_ID="arn:aws:bedrock:us-east-1:420796370696:inference-profile/global.amazon.nova-2-lite-v1:0"

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Create OAuth 2.0 credentials at https://console.cloud.google.com/
#  1. Create a project → APIs & Services → Credentials → OAuth 2.0 Client ID
#  2. Application type: Web application
#  3. Authorised JavaScript origins: http://localhost:3000 (and your prod URL)
#  4. Copy the Client ID into BOTH variables below.

# Used by the server to verify Google ID tokens (google-auth-library)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# Used by Vite to expose the Client ID to the frontend sign-in button
# (must match GOOGLE_CLIENT_ID exactly)
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# ── Session security ──────────────────────────────────────────────────────────
# Random secret for signing session JWTs.  Run:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-32-byte-hex-string"
